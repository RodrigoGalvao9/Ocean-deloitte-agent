OCEAN_BASE_URL=http://127.0.0.1:8000
OCEAN_DEFAULT_SCENARIO_MODE=conformance
# sse | ws | webhook | rest
OCEAN_CANAL=sse
# Somente se o servidor exigir
OCEAN_ADMIN_TOKEN=
# Somente para webhook com servidor remoto: URL publica (tunel) apontando para a porta local
OCEAN_WEBHOOK_URL=
OCEAN_WEBHOOK_PORTA=9000
# Modo LLM (--llm): Groq propoe
GROQ_API_KEY=
# OpenRouter revisa; sem a chave, o Groq tambem revisa
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
